# Tema
--theme=Dracula

# Mostrar números de linha
--line-range=:500

# Estilo (números, mudanças git, cabeçalho)
--style=numbers,changes,header

# Linguagem padrão para arquivos sem extensão
--map-syntax "*.conf:INI"
--map-syntax ".ignore:Git Ignore"

# Paginação
--paging=always

# No config file
--map-syntax "*.myext:JavaScript"
--map-syntax "Dockerfile.*:Dockerfile"
